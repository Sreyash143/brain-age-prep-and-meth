 # ---------------------------------------------------------------- predict
 
+def _ckpts(directory, prefix, fold):
+    """Strict match of '<prefix>_f<fold>_s<seed>.pt'.  The old glob '<prefix>_f<fold>_s*.pt' also matched
+    '<tag>.resume.pt' training-state files written by 11_train_experiment.py, which would be loaded as weights."""
+    import re
+    pat = re.compile(rf"^{re.escape(prefix)}_f{fold}_s\d+\.pt$")
+    return sorted(p for p in directory.iterdir() if pat.match(p.name))
+
